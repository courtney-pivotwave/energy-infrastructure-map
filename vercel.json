{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/social-log.json'",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "energy-infrastructure-map.vercel.app"
        }
      ],
      "destination": "https://strategicenergymap.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.strategicenergymap.org"
        }
      ],
      "destination": "https://strategicenergymap.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "strategicenergymap.com"
        }
      ],
      "destination": "https://strategicenergymap.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.strategicenergymap.com"
        }
      ],
      "destination": "https://strategicenergymap.org/$1",
      "permanent": true
    },
    {
      "source": "/embed",
      "destination": "/about.html#embed",
      "permanent": false
    },
    {
      "source": "/embed/",
      "destination": "/about.html#embed",
      "permanent": false
    }
  ]
}
